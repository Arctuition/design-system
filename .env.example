# Copy to `.env` (committed here; publishable/anon keys are public — they ship
# in the client bundle). AWS Amplify overrides these per deploy via the same
# variable names (real host env vars take precedence over .env).
# See .claude/decisions.md #8 and #10.

# Supabase project the front-end + build scripts talk to.
VITE_SUPABASE_PROJECT_ID=dnfzdqyiepjzqrigpvzw
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# CMS Google sign-in allowlist (frontend gate — see .claude/decisions.md #9).
# Comma-separated. Defaults to arcsite.com if unset.
VITE_CMS_ALLOWED_DOMAINS=arcsite.com
# VITE_CMS_ALLOWED_EMAILS=someone@gmail.com

# Edge-function deploy target is NOT set here — it's the GitHub Actions repo
# variable SUPABASE_PROJECT_REF (Settings → Secrets and variables → Actions →
# Variables), defaulting to dnfzdqyiepjzqrigpvzw. Keep it aligned with
# VITE_SUPABASE_PROJECT_ID above.
