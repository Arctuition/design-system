# Supabase public front-end config.
#
# These are publishable / anon keys — safe to commit (the same values ship
# inside the client JS bundle). Vite exposes VITE_*-prefixed vars to the app
# via import.meta.env, and the build scripts read them from process.env.
#
# Per-environment override: set the same variable names in AWS Amplify's
# environment-variable settings. Real env vars set by the build host take
# precedence over this file, so Amplify can swap these at deploy time.
VITE_SUPABASE_PROJECT_ID=dnfzdqyiepjzqrigpvzw
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_AbBNYAJCE4TWCWux_7WYkA_sSM9CMvY

# CMS Google sign-in allowlist (frontend gate — see .claude/decisions.md #9).
# Only these emails may sign in to EDIT the CMS; everyone else can only VIEW
# the public site (no login needed). Comma-separated.
VITE_CMS_ALLOWED_EMAILS=hongyu@arcsite.com,haowei@arcsite.com
# Optional: allow a whole Google Workspace domain instead of / in addition to
# the emails above. Left empty so access is limited to the two maintainers.
VITE_CMS_ALLOWED_DOMAINS=
